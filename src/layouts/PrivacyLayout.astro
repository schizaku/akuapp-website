---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AppInfo } from "@/data/apps";

/*
  `app` bilerek AppInfo'nun tamamı değil, yalnızca kullandığı iki alan.
  Böylece sayfa data/apps.ts'te kayıtlı olmayan bir uygulama için de
  kullanılabiliyor; tam AppInfo geçen mevcut sayfalar yapısal olarak
  uyumlu kaldığı için değişiklikten etkilenmiyor.
*/
interface Props {
  app: Pick<AppInfo, "slug" | "name">;
  /** Politikanın tarihi. Verilmezse ortak metnin tarihi kullanılır. */
  updated?: string;
  /** Geri bağlantısı. Varsayılan, uygulamanın kendi sayfası. */
  backHref?: string;
  backLabel?: string;
}

const { app, updated, backHref, backLabel } = Astro.props;

/*
  Varsayılan, ortak politika metninin en son gözden geçirildiği tarih.
  Kendi metnini yazan sayfalar `updated` ile kendi tarihini verir; ortak
  metni kullanan sayfaların çıktısı bu değerle birebir aynı kalır.
*/
const resolvedUpdated = updated ?? "July 22, 2026";
const resolvedBackHref = backHref ?? `/apps/${app.slug}`;
const resolvedBackLabel = backLabel ?? `Back to ${app.name}`;
---

<BaseLayout title={`${app.name} Privacy Policy - AkuAPPs`} description={`Privacy policy for ${app.name}.`}>
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <a class="text-sm font-medium text-teal-200 transition hover:text-white" href={resolvedBackHref}>
      {resolvedBackLabel}
    </a>
    <div class="mt-8 border-b border-white/10 pb-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-zinc-400">Privacy Policy</p>
      <h1 class="mt-3 text-4xl font-black tracking-normal text-white sm:text-5xl">{app.name}</h1>
      <p class="mt-4 text-sm text-zinc-500">Last updated: {resolvedUpdated}</p>
    </div>

    <div class="mt-10 max-w-none space-y-5 text-base leading-8 text-zinc-300 [&_a]:text-teal-200 [&_a]:transition [&_a:hover]:text-white [&_h2]:pt-5 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-white">
      {/*
        İçerik verilmezse aşağıdaki yer tutucu kullanılır — mevcut altı sayfa
        böyle çalışıyor ve çıktıları değişmiyor. Gerçek politikası yazılmış bir
        uygulama metnini çocuk içerik olarak geçer.
      */}
      <slot>
      <p>
        This Privacy Policy explains how AkuAPPs handles information when you use {app.name}.
        It applies to the mobile application and its related support services.
      </p>

      <h2>Information We Collect</h2>
      <p>
        The app may store settings, preferences, progress, favorites, or other content you create on
        your device. Depending on the features you use, third-party services may process limited
        technical information such as device type, operating system, app version, advertising
        identifiers, crash details, and general usage events. AkuAPPs does not sell personal information.
      </p>

      <h2>How We Use Information</h2>
      <p>
        We use information to provide app features, remember preferences, maintain security, diagnose
        crashes, measure performance, improve the experience, and support optional advertising or
        cloud-based functionality where those services are present.
      </p>

      <h2>Third Party Services</h2>
      <p>
        The app may use services supplied by Apple, Google, Firebase, Google Play Services, or advertising
        and analytics providers. Those providers process information under their own terms and privacy
        policies. The services actually used may vary by platform, app version, and enabled feature.
      </p>

      <h2>Children's Privacy</h2>
      <p>
        The app is not intended to knowingly collect personal information from children. If you believe
        a child has provided personal information, please contact AkuAPPs so the information can be
        reviewed and removed where appropriate.
      </p>

      <h2>Data Retention and Your Choices</h2>
      <p>
        Information stored only on your device can generally be removed by clearing app data or uninstalling
        the app. Where an account or cloud feature is available, you may contact us to request access,
        correction, or deletion. We retain service data only as long as reasonably necessary for the purposes
        described above, legal obligations, security, and dispute resolution.
      </p>

      <h2>Security</h2>
      <p>
        We use reasonable administrative and technical safeguards to protect information. No storage or
        transmission method is completely secure, so absolute security cannot be guaranteed.
      </p>

      <h2>Changes to This Policy</h2>
      <p>
        We may update this Privacy Policy when app features or service providers change. The latest version
        will remain available on this page with a revised "Last updated" date.
      </p>

      <h2>Contact Us</h2>
      <p>
        For privacy questions about {app.name}, contact AkuAPPs at
        <a href="mailto:hello@akuapps.com"> hello@akuapps.com</a>.
      </p>
      </slot>
    </div>
  </section>
</BaseLayout>
